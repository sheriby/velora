use super::common::*;

#[gpui::test]
async fn diag_search_jump_real_triton_file(cx: &mut TestAppContext) {
    init_editor_test_app(cx);
    let source = include_str!("/Users/sher/Github/AscendOpGenAgent/agents/triton-ascend-coder.md").to_string();
    let (editor, cx) = cx.add_window_view(move |_window, cx| Editor::from_markdown(cx, source, None));

    editor.update(cx, |editor, cx| {
        let live = editor.current_document_source(cx);
        let stable = editor.last_stable_source_text.clone();
        println!("DIAG live==stable: {}", live == stable);
        println!("DIAG live len={} stable len={}", live.len(), stable.len());
        // 与 open_search_hit 相同的行锚定换算（workspace 命中：line=428）
        let target_line = live
            .split_inclusive('\n')
            .position(|l| l.starts_with("## 沟通风格"))
            .expect("heading line in live text")
            + 1;
        println!("DIAG heading line (1-based) = {target_line}");
        let line_start = live
            .split_inclusive('\n')
            .take(target_line - 1)
            .map(str::len)
            .sum::<usize>();
        let line_text = live[line_start..].lines().next().unwrap();
        let title_off = line_text.find("沟通风格").expect("match on line");
        let range = (line_start + title_off)..(line_start + title_off + "沟通风格".len());
        println!("DIAG range={range:?} slice={:?}", &live[range.clone()]);

        editor.jump_to_document_search_range(range.clone(), cx);

        println!("DIAG cross_block={:?}", editor.cross_block_selection.is_some());
        let active_id = editor.active_entity_id;
        println!("DIAG active_id={active_id:?}");
        for (index, visible) in editor.document.visible_blocks().into_iter().enumerate() {
            let block = visible.entity.read(cx);
            let sel = &block.selected_range;
            if !sel.is_empty() || block.focus_handle.is_focused(gpui::NoWindow) {
                println!("DIAG block#{index} kind={:?} sel={sel:?} len={}", block.kind(), block.visible_len());
            }
        }
        // 映射对齐检查：每个标题映射切出的原文
        let source_now = editor.current_document_source(cx);
        for mapping in editor.build_source_target_mappings(cx) {
            let block = mapping.entity.read(cx);
            if let BlockKind::Heading { .. } = block.kind() {
                let slice = &source_now[mapping.full_source_range.clone()];
                let title = block.record.title.visible_text().to_string();
                if !slice.ends_with(title.as_str()) {
                    println!("DIAG MISALIGNED heading slice={slice:?} title={title:?} range={:?}", mapping.full_source_range);
                }
            }
        }
        println!("DIAG done");
    });
}
