<?xml version="1.0" encoding="utf-8"?>
<!-- 基于 Velotype 修改：安装包名称与标识改为 velora。 -->
<installer-gui-script minSpecVersion="1">
    <title>Velora</title>
    <welcome>Velora 是一款基于 Rust 与 GPUI 的 Markdown 编辑器。</welcome>
    <options customize="never" require-scripts="true" rootVolumeOnly="true"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="10.15"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="default">
            <line choice="velora"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="velora" title="安装 Velora" description="将 Velora 安装到应用程序目录">
        <pkg-ref id="app.velora.editor"/>
    </choice>
    <pkg-ref id="app.velora.editor" version="__VELORA_VERSION__" onConclusion="none">#velora-component.pkg</pkg-ref>
</installer-gui-script>
